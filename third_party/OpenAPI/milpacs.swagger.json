    "/api/v1/milpacs/position/search/{positionQuery}": {
      "get": {
        "summary": "Search for profiles by position title",
        "description": "Search for profiles using fuzzy matching on primary and secondary position titles, returns lite profiles for efficiency",
        "operationId": "MilpacService_SearchByPosition",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/protoLiteRoster"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "positionQuery",
            "in": "path",
            "required": true,
            "type": "string",
            "pattern": ".+"
          }
        ],
        "tags": [
          "Users, Milpacs, Position"
        ]
      }
    },
